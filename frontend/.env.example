# Base URL of the CodeShield AI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:3000

# OAuth 2.0 Web client ID from Google Cloud Console. Must match one of the
# comma-separated values the backend has in GOOGLE_CLIENT_ID. This is a
# public identifier (not a secret) and is safe to ship in frontend code.
VITE_GOOGLE_CLIENT_ID=

# Optional: mirrors the backend's MAX_ZIP_SIZE_MB so the client can reject an
# oversized .zip before uploading. Defaults to 50 if unset.
VITE_MAX_ZIP_SIZE_MB=50
