NODE_ENV=development
PORT=3000

# PostgreSQL connection string (must point to a database with the pgvector extension enabled)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vuln_detection

# ---------------------------------------------------------------------------
# LLM providers — Gemini is always attempted first, then Grok, then Llama
# (see LLM_PROVIDER_ORDER). Each provider is optional individually — you can
# run with just Gemini configured — but at least ONE must be configured or
# the server refuses to start.
# ---------------------------------------------------------------------------

# Google Gemini (primary provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# xAI Grok (first fallback). Uses xAI's OpenAI-compatible API
# (https://docs.x.ai/docs/api-reference) — check that page for currently
# supported model names before setting GROK_MODEL.
GROK_API_KEY=
GROK_MODEL=

# Llama (second fallback), served through ANY OpenAI-compatible
# /chat/completions endpoint — e.g. Groq, Together AI, Fireworks, OpenRouter,
# or a self-hosted vLLM/Ollama instance. LLAMA_API_KEY is optional if your
# endpoint doesn't require one (e.g. local inference).
LLAMA_API_KEY=
LLAMA_BASE_URL=
LLAMA_MODEL=

# Order to try providers in, comma-separated. Gemini should normally stay first.
LLM_PROVIDER_ORDER=gemini,grok,llama

# Embeddings (kept independently configurable from the chat model; Gemini-only, no fallback)
EMBEDDING_MODEL=text-embedding-004

# Per-provider-attempt timeout/retry budget. Kept small because a single
# logical LLM call may try multiple providers in sequence, and each retry
# spends limited free-tier quota.
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Authentication — Google Sign-In only. Clients must send a Google ID token
# as `Authorization: Bearer <token>`; the backend verifies it against
# Google directly (no separate password/session system). Comma-separate
# multiple client IDs if you have both a web and mobile OAuth client.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Rate limiting (applies to all of /api/*)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Maximum number of analyses (paste or ZIP) allowed to run at the same time.
# Protects a free/single-instance deployment and free LLM quotas from being
# exhausted by concurrent requests; additional requests get a 503 to retry.
MAX_CONCURRENT_ANALYSES=3

# Limits (all configurable)
MAX_CODE_LINES=10000
MAX_CODE_CHARACTERS=500000
MAX_ZIP_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=500
MAX_FILES_PER_PROJECT=5000

# CORS — set this to your actual frontend origin in production
CORS_ORIGIN=http://localhost:5173

# Path to the semgrep executable (override if not on PATH)
SEMGREP_PATH=semgrep

# Autonomous Manager Agent — hard safety limits (enforced in backend code, not just the prompt)
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_ANALYSIS_TIME_MS=120000

# ---------------------------------------------------------------------------
# LangChain / LangSmith Observability (Optional, OFF by default)
# ---------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codeshield-ai
